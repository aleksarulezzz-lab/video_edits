[{"name": "reel_1_bez_dizainera", "title": ["Этот рекламный ролик", "сделала нейросеть"], "duration": 60.684, "parts": [{"src": "rv", "a": 16.85, "b": 23.5, "out": 0.0}, {"src": "long", "a": 10.78, "b": 26.867, "out": 6.65}, {"src": "long", "a": 342.8, "b": 377.48, "out": 22.737}, {"src": "long", "a": 377.9, "b": 381.167, "out": 57.417}], "subs": [{"a": 0.11, "b": 2.45, "text": "А теперь представьте другое утро."}, {"a": 2.73, "b": 5.416, "text": "Вы просыпаетесь, наливаете себе кофе,"}, {"a": 5.416, "b": 6.65, "text": "открываете почту,"}, {"a": 8.47, "b": 10.42, "text": "Я ни разу не моушн-дизайнер и не"}, {"a": 10.44, "b": 12.32, "text": "открывала ни одной программы для создания"}, {"a": 12.34, "b": 14.653, "text": "моушн-анимации. Сейчас покажу, как я"}, {"a": 14.673, "b": 16.593, "text": "создавала этот ролик со всеми ошибками"}, {"a": 16.613, "b": 19.273, "text": "нейросети и переделками, а их было немало,"}, {"a": 19.293, "b": 21.013, "text": "в частности, один раз меня нейросеть даже"}, {"a": 21.033, "b": 22.737, "text": "поселила посреди океана."}, {"a": 22.817, "b": 24.457, "text": "Итого, теперь у меня есть ролик в"}, {"a": 24.477, "b": 26.117, "text": "горизонтальном формате для YouTube и"}, {"a": 26.137, "b": 28.937, "text": "вертикальная версия этого же ролика для рилс."}, {"a": 28.957, "b": 31.137, "text": "На всё это у меня ушло плюс-минус"}, {"a": 31.157, "b": 33.817, "text": "час работы, из них минут 20 моего"}, {"a": 33.837, "b": 36.557, "text": "активного включения, всё остальное — рендеры и"}, {"a": 36.577, "b": 40.077, "text": "проверка финальная того, что получилось. Одна"}, {"a": 40.097, "b": 41.917, "text": "подписка на Claude мне понадобилась: у меня"}, {"a": 41.937, "b": 44.857, "text": "тариф Pro за 20 долларов и бесплатный"}, {"a": 44.877, "b": 46.857, "text": "тариф на ElevenLabs, который мне вот"}, {"a": 46.877, "b": 47.877, "text": "так вот с головой хватило,"}, {"a": 47.897, "b": 50.957, "text": "на то, чтобы сгенерировать озвучку для"}, {"a": 50.977, "b": 53.737, "text": "полутораминутного ролика. То же самое можно"}, {"a": 53.757, "b": 56.377, "text": "сделать под любую услугу, под любой продукт,"}, {"a": 56.397, "b": 57.417, "text": "для любой ниши."}, {"a": 57.437, "b": 59.577, "text": "Вопросы клиентов – это и есть сценарий"}, {"a": 59.597, "b": 60.684, "text": "для вашего видео."}], "windows": [{"a": 6.65, "b": 21.223, "kind": "stack"}, {"a": 6.65, "b": 15.763, "kind": "vis"}, {"a": 15.863, "b": 21.223, "kind": "vis"}, {"a": 21.223, "b": 22.737, "kind": "clip"}, {"a": 22.737, "b": 29.207, "kind": "clip"}, {"a": 29.207, "b": 52.227, "kind": "tier"}, {"a": 57.687, "b": 60.41, "kind": "stack"}, {"a": 60.51, "b": 60.684, "kind": "step"}], "over": [], "rvins": []}, {"name": "reel_2_oshibki", "title": ["Нейросеть поселила меня", "посреди океана"], "duration": 59.046, "parts": [{"src": "long", "a": 246.367, "b": 283.1, "out": 0.0}, {"src": "long", "a": 283.72, "b": 306.033, "out": 36.733}], "subs": [{"a": 0.0, "b": 0.87, "text": "Теперь честно о"}, {"a": 0.89, "b": 2.83, "text": "том, что пошло не так. Первое: в"}, {"a": 2.85, "b": 5.83, "text": "сцене про географию точка «ваш город» на"}, {"a": 5.85, "b": 8.13, "text": "первом варианте оказалась посреди океана."}, {"a": 8.15, "b": 10.59, "text": "Второе: я сократила некоторый текст,"}, {"a": 10.61, "b": 12.71, "text": "чтобы уложиться в хронометраж, а нейросеть"}, {"a": 12.73, "b": 14.81, "text": "составила надписи по старому сценарию."}, {"a": 14.83, "b": 16.63, "text": "Получался такой рассинхрон, что я говорю"}, {"a": 16.65, "b": 19.53, "text": "одни слова, а кадры появляются в тему"}, {"a": 19.55, "b": 21.79, "text": "того текста, который я убрала. Это тоже"}, {"a": 21.81, "b": 25.78, "text": "я на этапе внесения правок исправила."}, {"a": 25.8, "b": 27.4, "text": "И третий момент, который я правила,"}, {"a": 27.42, "b": 29.92, "text": "это было уже мое собственное желание,"}, {"a": 29.94, "b": 31.84, "text": "что изначально я видео хотела вести на"}, {"a": 31.86, "b": 33.64, "text": "переписку в личку со мной,"}, {"a": 33.66, "b": 35.9, "text": "а потом решила сделать ссылку уже на"}, {"a": 35.92, "b": 36.733, "text": "телеграм-канал."}, {"a": 36.733, "b": 37.7, "text": "Теперь этот ролик ведет на"}, {"a": 37.72, "b": 39.7, "text": "канал и свой личный аккаунт я на"}, {"a": 39.72, "b": 41.76, "text": "последнем кадре не показываю."}, {"a": 41.78, "b": 44.15, "text": "Мораль всей басни такова, что нейросеть"}, {"a": 44.17, "b": 46.29, "text": "делает за вас основной объем работы. Но"}, {"a": 46.31, "b": 49.65, "text": "контроль, финальные версии, ваши глаза,"}, {"a": 49.67, "b": 52.59, "text": "вкус остаются за вами. Смотрите и проверяйте"}, {"a": 52.61, "b": 55.33, "text": "каждый кадр, прежде чем принять работу и"}, {"a": 55.35, "b": 57.91, "text": "опубликовать ее у себя на странице или"}, {"a": 57.93, "b": 59.046, "text": "передать заказчику."}], "windows": [{"a": 0.0, "b": 1.1, "kind": "step"}, {"a": 4.32, "b": 6.72, "kind": "clip"}, {"a": 6.72, "b": 10.72, "kind": "insert"}, {"a": 12.26, "b": 16.66, "kind": "clip"}, {"a": 30.73, "b": 36.733, "kind": "endcard"}, {"a": 36.733, "b": 40.07, "kind": "clip"}, {"a": 46.34, "b": 59.046, "kind": "stack"}, {"a": 58.736, "b": 59.046, "kind": "step"}], "over": [], "rvins": []}, {"name": "reel_3_snachala_tekst", "title": ["Не просите у нейросети", "сразу видео"], "duration": 53.664, "parts": [{"src": "long", "a": 100.033, "b": 125.483, "out": 0.0}, {"src": "long", "a": 125.653, "b": 153.867, "out": 25.45}], "subs": [{"a": 0.074, "b": 2.234, "text": "Дальше начиналась самая интересная часть,"}, {"a": 2.254, "b": 3.967, "text": "это подготовка текста."}, {"a": 3.987, "b": 5.907, "text": "После созвона в трекинг-группе я просто"}, {"a": 5.927, "b": 9.107, "text": "надиктовала свои мысли, свои идеи,"}, {"a": 9.127, "b": 10.567, "text": "которые я хотела бы заложить в этот"}, {"a": 10.587, "b": 11.547, "text": "ролик,"}, {"a": 11.967, "b": 13.774, "text": "транскрибировала это в текст. Вопросы"}, {"a": 13.794, "b": 16.734, "text": "участниц, мысль о том, что реклама дорожает,"}, {"a": 16.774, "b": 19.894, "text": "и картинку идеального утра отдала в Claude"}, {"a": 19.914, "b": 22.054, "text": "все это вместе с описанием агента и"}, {"a": 22.074, "b": 24.414, "text": "референсным видео, которое я скачала на"}, {"a": 24.434, "b": 25.45, "text": "предыдущем шаге."}, {"a": 25.45, "b": 27.11, "text": "И сразу написала,"}, {"a": 27.13, "b": 29.47, "text": "что сначала ты мне подготовь текст,"}, {"a": 29.49, "b": 31.514, "text": "сценарий, ничего пока ещё не генери,"}, {"a": 31.534, "b": 32.814, "text": "потому что если она сразу даст мне"}, {"a": 32.834, "b": 34.914, "text": "видео, то возможно оно мне совсем не"}, {"a": 34.934, "b": 37.237, "text": "понравится. И тут нейросеть меня поправила,"}, {"a": 37.257, "b": 38.417, "text": "потому что я хотела сказать,"}, {"a": 38.437, "b": 41.537, "text": "что агент тратит 2–3% от суточного"}, {"a": 41.557, "b": 43.317, "text": "лимита, а нейросеть поправила меня,"}, {"a": 43.337, "b": 45.617, "text": "что иногда может тратиться больше лимитов,"}, {"a": 45.637, "b": 46.877, "text": "поэтому лучше не говорить, не обещать"}, {"a": 46.897, "b": 48.864, "text": "какую-то конкретную цифру. Поэтому мы"}, {"a": 48.884, "b": 52.224, "text": "сохранили формулировку, что тратят небольшую"}, {"a": 52.244, "b": 53.664, "text": "часть от суточного лимита."}], "windows": [{"a": 0.0, "b": 0.404, "kind": "screen"}, {"a": 0.404, "b": 3.167, "kind": "screen"}, {"a": 3.167, "b": 4.867, "kind": "step"}, {"a": 5.677, "b": 9.877, "kind": "insert"}, {"a": 13.704, "b": 19.064, "kind": "stack"}, {"a": 13.704, "b": 14.764, "kind": "vis"}, {"a": 14.864, "b": 17.024, "kind": "vis"}, {"a": 17.124, "b": 19.064, "kind": "vis"}, {"a": 19.164, "b": 25.45, "kind": "screen"}, {"a": 25.45, "b": 27.16, "kind": "screen"}, {"a": 31.784, "b": 36.384, "kind": "insert"}, {"a": 36.067, "b": 51.254, "kind": "screen"}], "over": [], "rvins": []}, {"name": "reel_4_klod", "title": ["Почему я написала", "Claude как «Клод»"], "duration": 40.949, "parts": [{"src": "long", "a": 165.067, "b": 168.907, "out": 0.0}, {"src": "long", "a": 169.197, "b": 191.617, "out": 3.84}, {"src": "long", "a": 191.877, "b": 198.5, "out": 26.26}, {"src": "long", "a": 364.467, "b": 372.533, "out": 32.883}], "subs": [{"a": 0.066, "b": 2.046, "text": "Теперь текст у меня был готов,"}, {"a": 2.066, "b": 3.84, "text": "и ему нужен был голос."}, {"a": 3.84, "b": 7.29, "text": "Голос я сгенерировала в сервисе ElevenLabs."}, {"a": 7.31, "b": 9.79, "text": "Лайфхак. Нейросеть сразу подготовила текст"}, {"a": 9.81, "b": 12.63, "text": "для озвучки. Числа были прописаны словами,"}, {"a": 12.65, "b": 15.35, "text": "а название нейросети «Клод» было прописано"}, {"a": 15.37, "b": 18.35, "text": "русскими буквами, иначе синтезатор мог бы"}, {"a": 18.37, "b": 20.81, "text": "прочитать это как-то криво и неправильно."}, {"a": 20.83, "b": 22.73, "text": "Перед генерацией я часть текста также"}, {"a": 22.75, "b": 24.99, "text": "сократила, чтобы уложиться в хронометраж и"}, {"a": 25.01, "b": 26.26, "text": "не растягивать ролик."}, {"a": 26.26, "b": 28.693, "text": "А теперь представьте другое утро."}, {"a": 28.713, "b": 31.493, "text": "Вы просыпаетесь, наливаете себе кофе,"}, {"a": 31.513, "b": 32.883, "text": "открываете почту…"}, {"a": 33.356, "b": 35.336, "text": "тариф на ElevenLabs, который мне вот"}, {"a": 35.356, "b": 36.356, "text": "так вот с головой хватило,"}, {"a": 36.376, "b": 39.436, "text": "на то, чтобы сгенерировать озвучку для"}, {"a": 39.456, "b": 40.949, "text": "полутораминутного ролика."}], "windows": [{"a": 0.0, "b": 1.396, "kind": "step"}, {"a": 5.516, "b": 8.116, "kind": "vis"}, {"a": 7.21, "b": 8.91, "kind": "step"}, {"a": 8.2, "b": 10.95, "kind": "screen"}, {"a": 11.1, "b": 23.68, "kind": "stack"}, {"a": 23.68, "b": 26.243, "kind": "broll"}, {"a": 26.243, "b": 26.26, "kind": "listen"}, {"a": 26.26, "b": 32.716, "kind": "listen"}, {"a": 32.596, "b": 32.883, "kind": "step"}, {"a": 32.883, "b": 40.706, "kind": "tier"}], "over": [], "rvins": []}, {"name": "reel_5_vakansiya", "title": ["Вакансия: человек", "на анимации в Claude"], "duration": 53.136, "parts": [{"src": "long", "a": 427.467, "b": 429.047, "out": 0.0}, {"src": "long", "a": 429.297, "b": 430.397, "out": 1.58}, {"src": "long", "a": 431.037, "b": 440.707, "out": 2.68}, {"src": "long", "a": 441.567, "b": 448.657, "out": 12.35}, {"src": "long", "a": 449.447, "b": 464.667, "out": 19.44}, {"src": "long", "a": 465.327, "b": 466.577, "out": 34.66}, {"src": "long", "a": 467.427, "b": 475.567, "out": 35.91}, {"src": "long", "a": 475.747, "b": 484.833, "out": 44.05}], "subs": [{"a": 0.106, "b": 1.58, "text": "А теперь про деньги."}, {"a": 3.83, "b": 5.39, "text": "мне стало интересно, сколько же можно"}, {"a": 5.41, "b": 7.87, "text": "зарабатывать на создании таких роликов с"}, {"a": 7.89, "b": 11.193, "text": "моушн-анимацией. Я пошла на биржу фриланса и"}, {"a": 11.213, "b": 12.35, "text": "поискала заказы."}, {"a": 14.193, "b": 18.153, "text": "недели: «Создание анимационного ролика 20–25"}, {"a": 18.173, "b": 19.44, "text": "секунд для сайта»,"}, {"a": 22.106, "b": 25.006, "text": "ИИ-креативов». Заказчик прямо просит написать,"}, {"a": 25.026, "b": 27.266, "text": "с какими нейросетями ты работаешь. И вот"}, {"a": 27.286, "b": 29.826, "text": "мой любимый: «Постоянный человек на анимации"}, {"a": 29.846, "b": 31.566, "text": "в Claude». Ролики до минуты,"}, {"a": 31.586, "b": 33.686, "text": "вся работа в Claude, опыт в анимации"}, {"a": 33.706, "b": 34.66, "text": "не обязателен. Ну, классно же!"}, {"a": 34.66, "b": 35.91, "text": "Ну, классно же!"}, {"a": 36.923, "b": 39.543, "text": "Заказчики уже ищут не конкретно прям"}, {"a": 39.563, "b": 42.103, "text": "моушн-дизайнера с дорогими программами, а"}, {"a": 44.623, "b": 46.003, "text": "помощью нейросети."}, {"a": 46.263, "b": 48.623, "text": "На биржах фриланса такой ролик стоит от 3"}, {"a": 48.643, "b": 49.943, "text": "000 ₽ и выше."}, {"a": 49.963, "b": 51.903, "text": "И это ровно то, что я сейчас"}, {"a": 51.923, "b": 53.136, "text": "показала в видео."}], "windows": [{"a": 0.0, "b": 1.456, "kind": "step"}, {"a": 8.943, "b": 12.35, "kind": "screen"}, {"a": 12.383, "b": 19.44, "kind": "board"}, {"a": 19.44, "b": 34.66, "kind": "board"}, {"a": 34.66, "b": 35.91, "kind": "board"}, {"a": 35.91, "b": 44.05, "kind": "board"}, {"a": 44.05, "b": 50.113, "kind": "board"}, {"a": 50.213, "b": 53.136, "kind": "insert"}], "over": [{"a": 8.973, "b": 14.513, "img": "reelimg/fl_8.5.png"}, {"a": 14.513, "b": 19.44, "img": "reelimg/fl_16.5.png"}, {"a": 19.44, "b": 23.066, "img": "reelimg/fl_22.png"}, {"a": 23.066, "b": 27.826, "img": "reelimg/fl_26.5.png"}, {"a": 27.826, "b": 35.91, "img": "reelimg/fl_33.png"}, {"a": 47.403, "b": 49.863, "img": "reelimg/flax.png"}], "rvins": []}, {"name": "reel_6_reklama_dorozhaet", "title": ["Реклама дорожает.", "А клиенты нужны каждый месяц"], "duration": 18.9, "parts": [{"src": "rv", "a": 0.0, "b": 16.9, "out": 2.0}], "subs": [{"a": 2.0, "b": 4.132, "text": "Реклама дорожает каждый год,"}, {"a": 4.132, "b": 6.34, "text": "а клиенты нужны каждый месяц."}, {"a": 6.5, "b": 9.505, "text": "За три года привлечь одного клиента через рекламу"}, {"a": 9.505, "b": 12.08, "text": "стало дороже почти в два с половиной раза."}, {"a": 12.38, "b": 14.72, "text": "Крупный бизнес еще может за это платить,"}, {"a": 14.88, "b": 16.933, "text": "а маленьким экспертам остаются"}, {"a": 16.933, "b": 18.78, "text": "контент и сарафанное радио."}], "windows": [], "over": [], "rvins": [], "intro": {"lines": ["Как делать такие ролики", "и $арабатывать на этом"], "d": 2.0}}, {"name": "reel_6_reklama_dorozhaet_insta", "title": ["Реклама дорожает.", "А клиенты нужны каждый месяц"], "duration": 18.9, "parts": [{"src": "rv", "a": 0.0, "b": 16.9, "out": 2.0}], "subs": [{"a": 2.0, "b": 4.132, "text": "Реклама дорожает каждый год,"}, {"a": 4.132, "b": 6.34, "text": "а клиенты нужны каждый месяц."}, {"a": 6.5, "b": 9.505, "text": "За три года привлечь одного клиента через рекламу"}, {"a": 9.505, "b": 12.08, "text": "стало дороже почти в два с половиной раза."}, {"a": 12.38, "b": 14.72, "text": "Крупный бизнес еще может за это платить,"}, {"a": 14.88, "b": 16.933, "text": "а маленьким экспертам остаются"}, {"a": 16.933, "b": 18.78, "text": "контент и сарафанное радио."}], "windows": [], "over": [], "rvins": [], "intro": {"lines": ["Как делать такие ролики", "и $арабатывать на этом"], "d": 2.0}, "cta": "comment"}, {"name": "reel_7_drugoe_utro", "title": ["Представьте", "другое утро…"], "duration": 31.85, "parts": [{"src": "rv", "a": 16.85, "b": 37.75, "out": 0.0}, {"src": "rv", "a": 45.9, "b": 56.85, "out": 20.9}], "subs": [{"a": 0.11, "b": 2.45, "text": "А теперь представьте другое утро."}, {"a": 2.73, "b": 5.416, "text": "Вы просыпаетесь, наливаете себе кофе,"}, {"a": 5.416, "b": 6.65, "text": "открываете почту,"}, {"a": 6.79, "b": 8.191, "text": "а там уже лежат 10"}, {"a": 8.191, "b": 11.07, "text": "готовых писем вашим будущим клиентам."}, {"a": 11.07, "b": 13.93, "text": "Их подготовили ваши ИИ-сотрудники."}, {"a": 14.31, "b": 16.01, "text": "Разведчик находит компании."}, {"a": 16.41, "b": 17.683, "text": "Исследователь смотрит,"}, {"a": 17.683, "b": 19.13, "text": "где им нужна ваша помощь,"}, {"a": 19.21, "b": 20.83, "text": "а менеджер пишет письмо."}, {"a": 20.96, "b": 22.191, "text": "Вам остается только"}, {"a": 22.191, "b": 24.2, "text": "проверить и нажать «Отправить»."}, {"a": 24.2, "b": 26.12, "text": "Меньше минуты на одно письмо."}, {"a": 26.48, "b": 28.66, "text": "Десять минут утром — и вы свободны."}, {"a": 28.8, "b": 31.76, "text": "Письма работают, а вы живете свой день."}, {"a": 31.76, "b": 31.811, "text": "Работаете над проектами, гуляете,"}, {"a": 31.811, "b": 31.85, "text": "проводите время с семьей."}], "windows": [], "over": [], "rvins": []}, {"name": "reel_8_ne_tolko_golova", "title": ["Рилсы не обязаны быть", "говорящей головой"], "duration": 34.523, "parts": [{"src": "long", "a": 392.4, "b": 421.57, "out": 0.0}, {"src": "long", "a": 422.18, "b": 427.533, "out": 29.17}], "subs": [{"a": 1.103, "b": 2.823, "text": "Технологией, как моушн-анимация, можно"}, {"a": 2.843, "b": 5.083, "text": "разбавить видео с говорящей головой."}, {"a": 5.103, "b": 7.303, "text": "Например, если вы делаете много коротких"}, {"a": 7.323, "b": 9.143, "text": "роликов из одного длинного видео,"}, {"a": 9.163, "b": 11.023, "text": "то получается несколько однообразный такой"}, {"a": 11.043, "b": 13.543, "text": "формат, и его очень хорошо разнообразит как"}, {"a": 13.563, "b": 14.543, "text": "раз моушн-анимация."}, {"a": 14.563, "b": 16.383, "text": "Вам ничего не нужно будет переснимать,"}, {"a": 16.403, "b": 16.926, "text": "доснимать."}, {"a": 16.926, "b": 18.913, "text": "Можно сделать полностью рилс из моушн-"}, {"a": 18.933, "b": 21.033, "text": "анимации, можно вставлять его точечно,"}, {"a": 21.053, "b": 23.273, "text": "но в любом случае формат и подача"}, {"a": 23.293, "b": 25.233, "text": "уже сразу оживет, будет интереснее смотреть."}, {"a": 25.253, "b": 27.573, "text": "И в производстве это очень просто,"}, {"a": 29.663, "b": 32.163, "text": "замысел, есть закадровый голос, всё"}, {"a": 32.183, "b": 34.523, "text": "остальное делает за вас нейросеть."}], "windows": [{"a": 2.693, "b": 5.293, "kind": "broll"}, {"a": 5.353, "b": 11.853, "kind": "insert"}, {"a": 29.713, "b": 34.213, "kind": "stack"}, {"a": 34.213, "b": 34.523, "kind": "step"}], "over": [], "rvins": [{"a": 2.743, "b": 5.543, "at": 56.9}, {"a": 9.623, "b": 12.423, "at": 61.0}, {"a": 12.703, "b": 15.503, "at": 68.3}, {"a": 19.713, "b": 22.513, "at": 74.5}, {"a": 29.463, "b": 32.263, "at": 79.3}]}]