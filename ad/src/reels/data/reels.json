[{"name": "reel_1_bez_dizainera", "title": ["Этот рекламный ролик", "сделала нейросеть"], "duration": 53.867, "parts": [{"src": "long", "a": 10.233333333333333, "b": 26.866666666666667, "out": 0.0}, {"src": "long", "a": 346.53333333333336, "b": 383.76666666666665, "out": 16.633}], "subs": [{"a": 0.16, "b": 1.739, "text": "Вот этот ролик мне сделала"}, {"a": 1.739, "b": 2.347, "text": "нейросеть."}, {"a": 2.367, "b": 4.317, "text": "Я ни разу не моушн-дизайнер и не"}, {"a": 4.337, "b": 5.841, "text": "открывала ни одной программы для"}, {"a": 5.841, "b": 6.217, "text": "создания"}, {"a": 6.237, "b": 8.484, "text": "моушн-анимации. Сейчас покажу, как"}, {"a": 8.484, "b": 8.55, "text": "я"}, {"a": 8.57, "b": 10.075, "text": "создавала этот ролик со всеми"}, {"a": 10.075, "b": 10.49, "text": "ошибками"}, {"a": 10.51, "b": 12.716, "text": "нейросети и переделками, а их было"}, {"a": 12.716, "b": 13.17, "text": "немало,"}, {"a": 13.19, "b": 14.308, "text": "в частности, один раз меня"}, {"a": 14.308, "b": 14.91, "text": "нейросеть даже"}, {"a": 14.93, "b": 16.633, "text": "поселила посреди океана."}, {"a": 16.713, "b": 18.353, "text": "Итого, теперь у меня есть ролик в"}, {"a": 18.373, "b": 19.966, "text": "горизонтальном формате для YouTube"}, {"a": 19.966, "b": 20.013, "text": "и"}, {"a": 20.033, "b": 21.815, "text": "вертикальная версия этого же"}, {"a": 21.815, "b": 22.833, "text": "ролика для рилс."}, {"a": 22.853, "b": 25.033, "text": "На всё это у меня ушло плюс-минус"}, {"a": 25.053, "b": 27.713, "text": "час работы, из них минут 20 моего"}, {"a": 27.733, "b": 29.697, "text": "активного включения, всё остальное"}, {"a": 29.697, "b": 30.333, "text": "— рендеры и"}, {"a": 30.353, "b": 32.622, "text": "проверка финальная того, что"}, {"a": 32.622, "b": 33.513, "text": "получилось."}, {"a": 33.543, "b": 34.589, "text": "Одна подписка на Claude мне"}, {"a": 34.589, "b": 35.363, "text": "понадобилась: у меня"}, {"a": 35.383, "b": 37.294, "text": "тариф Pro за 20 долларов, и"}, {"a": 37.294, "b": 38.427, "text": "бесплатный тариф"}, {"a": 38.447, "b": 40.267, "text": "на ElevenLabs, который мне вот так"}, {"a": 40.287, "b": 41.507, "text": "вот с головой хватило, на то,"}, {"a": 41.527, "b": 44.247, "text": "чтобы сгенерировать озвучку для"}, {"a": 44.267, "b": 46.309, "text": "полутораминутного ролика. То же"}, {"a": 46.309, "b": 47.033, "text": "самое можно"}, {"a": 47.053, "b": 48.82, "text": "сделать под любую услугу, под"}, {"a": 48.82, "b": 49.673, "text": "любой продукт,"}, {"a": 49.693, "b": 50.597, "text": "для любой ниши."}, {"a": 50.617, "b": 52.294, "text": "Вопросы клиентов – это и есть"}, {"a": 52.294, "b": 52.757, "text": "сценарий"}, {"a": 52.777, "b": 53.867, "text": "для вашего видео."}], "windows": [{"a": 15.12, "b": 16.633, "kind": "clip"}, {"a": 16.633, "b": 23.103, "kind": "clip"}, {"a": 23.103, "b": 45.517, "kind": "tier"}]}, {"name": "reel_2_oshibki", "title": ["Нейросеть поселила меня", "посреди океана"], "duration": 58.567, "parts": [{"src": "long", "a": 251.06666666666666, "b": 309.6333333333333, "out": 0.0}], "subs": [{"a": 0.0, "b": 1.87, "text": "Теперь честно о том, что пошло не"}, {"a": 1.89, "b": 4.369, "text": "так. Первое: в сцене про географию"}, {"a": 4.369, "b": 4.733, "text": "точка"}, {"a": 4.753, "b": 6.415, "text": "«ваш город» на первом варианте"}, {"a": 6.415, "b": 6.913, "text": "оказалась"}, {"a": 6.933, "b": 8.666, "text": "посреди океана. Второе: я"}, {"a": 8.666, "b": 9.983, "text": "сократила некоторый"}, {"a": 10.003, "b": 11.178, "text": "текст, чтобы уложиться в"}, {"a": 11.178, "b": 11.863, "text": "хронометраж, а"}, {"a": 11.883, "b": 13.586, "text": "нейросеть составила надписи по"}, {"a": 13.586, "b": 13.983, "text": "старому"}, {"a": 14.003, "b": 15.217, "text": "сценарию. Получался такой"}, {"a": 15.217, "b": 16.043, "text": "рассинхрон, что я"}, {"a": 16.063, "b": 18.061, "text": "говорю одни слова, а кадры"}, {"a": 18.061, "b": 18.983, "text": "появляются в"}, {"a": 19.003, "b": 20.552, "text": "тему того текста, который я"}, {"a": 20.552, "b": 21.183, "text": "убрала. Это"}, {"a": 21.203, "b": 23.119, "text": "тоже вот я на этапе внесения"}, {"a": 23.119, "b": 24.283, "text": "правок исправила."}, {"a": 25.1, "b": 26.324, "text": "И третий момент, который я"}, {"a": 26.324, "b": 26.7, "text": "правила,"}, {"a": 26.72, "b": 28.56, "text": "это было уже мое собственное"}, {"a": 28.56, "b": 29.086, "text": "желание,"}, {"a": 29.106, "b": 30.595, "text": "что изначально я видео хотела"}, {"a": 30.595, "b": 31.006, "text": "вести на"}, {"a": 31.026, "b": 32.806, "text": "переписку в личку со мной,"}, {"a": 32.826, "b": 34.938, "text": "а потом решила сделать ссылку уже"}, {"a": 34.938, "b": 35.066, "text": "на"}, {"a": 35.086, "b": 37.018, "text": "телеграм-канал. Теперь этот ролик"}, {"a": 37.018, "b": 37.486, "text": "ведет на"}, {"a": 37.506, "b": 39.486, "text": "канал и свой личный аккаунт я на"}, {"a": 39.506, "b": 41.546, "text": "последнем кадре не показываю."}, {"a": 41.566, "b": 43.375, "text": "Мораль всей басни такова, что"}, {"a": 43.375, "b": 43.936, "text": "нейросеть"}, {"a": 43.956, "b": 45.518, "text": "делает за вас основной объем"}, {"a": 45.518, "b": 46.076, "text": "работы. Но"}, {"a": 46.096, "b": 48.909, "text": "контроль, финальные версии, ваши"}, {"a": 48.909, "b": 49.436, "text": "глаза,"}, {"a": 49.456, "b": 51.577, "text": "вкус остаются за вами. Смотрите и"}, {"a": 51.577, "b": 52.22, "text": "проверяйте"}, {"a": 52.24, "b": 54.402, "text": "каждый кадр, прежде чем принять"}, {"a": 54.402, "b": 54.96, "text": "работу и"}, {"a": 54.98, "b": 57.225, "text": "опубликовать ее у себя на странице"}, {"a": 57.225, "b": 57.423, "text": "или"}, {"a": 57.443, "b": 58.567, "text": "передать заказчику."}], "windows": [{"a": 0.0, "b": 0.75, "kind": "stinger"}, {"a": 4.203, "b": 6.603, "kind": "clip"}, {"a": 6.603, "b": 10.603, "kind": "insert"}, {"a": 11.933, "b": 16.333, "kind": "clip"}, {"a": 29.896, "b": 36.256, "kind": "endcard"}, {"a": 36.256, "b": 39.856, "kind": "clip"}]}, {"name": "reel_3_snachala_tekst", "title": ["Не просите у нейросети", "сразу видео"], "duration": 50.0, "parts": [{"src": "long", "a": 109.53333333333333, "b": 159.53333333333333, "out": 0.0}], "subs": [{"a": 0.154, "b": 1.771, "text": "После созвона в трекинг-группе я"}, {"a": 1.771, "b": 2.074, "text": "просто"}, {"a": 2.094, "b": 5.274, "text": "надиктовала свои мысли, свои идеи,"}, {"a": 5.294, "b": 6.565, "text": "которые я хотела бы заложить в"}, {"a": 6.565, "b": 6.734, "text": "этот"}, {"a": 6.754, "b": 7.714, "text": "ролик,"}, {"a": 8.134, "b": 9.589, "text": "транскрибировала это в текст."}, {"a": 9.589, "b": 9.94, "text": "Вопросы"}, {"a": 9.96, "b": 12.285, "text": "участниц, мысль о том, что реклама"}, {"a": 12.285, "b": 12.9, "text": "дорожает,"}, {"a": 12.94, "b": 15.451, "text": "и картинку идеального утра отдала"}, {"a": 15.451, "b": 16.06, "text": "в Claude"}, {"a": 16.08, "b": 18.157, "text": "все это вместе с описанием агента"}, {"a": 18.157, "b": 18.22, "text": "и"}, {"a": 18.24, "b": 19.964, "text": "референсным видео, которое я"}, {"a": 19.964, "b": 20.58, "text": "скачала на"}, {"a": 20.6, "b": 23.447, "text": "предыдущем шаге. И сразу написала,"}, {"a": 23.467, "b": 25.394, "text": "что сначала ты мне подготовь"}, {"a": 25.394, "b": 25.807, "text": "текст,"}, {"a": 25.827, "b": 27.445, "text": "сценарий, ничего пока ещё не"}, {"a": 27.445, "b": 27.85, "text": "генери,"}, {"a": 27.87, "b": 29.15, "text": "потому что если она сразу даст мне"}, {"a": 29.17, "b": 31.131, "text": "видео, то возможно оно мне совсем"}, {"a": 31.131, "b": 31.25, "text": "не"}, {"a": 31.27, "b": 33.025, "text": "понравится. И тут нейросеть меня"}, {"a": 33.025, "b": 33.574, "text": "поправила,"}, {"a": 33.594, "b": 34.754, "text": "потому что я хотела сказать,"}, {"a": 34.774, "b": 37.874, "text": "что агент тратит 2–3% от суточного"}, {"a": 37.894, "b": 39.395, "text": "лимита, а нейросеть поправила"}, {"a": 39.395, "b": 39.654, "text": "меня,"}, {"a": 39.674, "b": 41.509, "text": "что иногда может тратиться больше"}, {"a": 41.509, "b": 41.954, "text": "лимитов,"}, {"a": 41.974, "b": 42.973, "text": "поэтому лучше не говорить, не"}, {"a": 42.973, "b": 43.214, "text": "обещать"}, {"a": 43.234, "b": 45.091, "text": "какую-то конкретную цифру. Поэтому"}, {"a": 45.091, "b": 45.2, "text": "мы"}, {"a": 45.22, "b": 47.861, "text": "сохранили формулировку, что тратят"}, {"a": 47.861, "b": 48.56, "text": "небольшую"}, {"a": 48.58, "b": 50.0, "text": "часть от суточного лимита."}], "windows": [{"a": 0.0, "b": 0.684, "kind": "stinger"}, {"a": 1.844, "b": 6.044, "kind": "insert"}, {"a": 15.33, "b": 23.497, "kind": "screen"}, {"a": 28.12, "b": 32.72, "kind": "insert"}, {"a": 32.404, "b": 47.59, "kind": "screen"}]}, {"name": "reel_4_klod", "title": ["Почему я написала", "Claude как «Клод»"], "duration": 33.433, "parts": [{"src": "long", "a": 170.73333333333332, "b": 204.16666666666666, "out": 0.0}], "subs": [{"a": 0.067, "b": 2.047, "text": "Теперь текст у меня был готов,"}, {"a": 2.067, "b": 3.957, "text": "и ему нужен был голос."}, {"a": 3.977, "b": 6.636, "text": "Голос я сгенерировала в сервисе"}, {"a": 6.636, "b": 7.58, "text": "ElevenLabs."}, {"a": 7.6, "b": 9.052, "text": "Лайфхак. Нейросеть сразу"}, {"a": 9.052, "b": 10.08, "text": "подготовила текст"}, {"a": 10.1, "b": 12.37, "text": "для озвучки. Числа были прописаны"}, {"a": 12.37, "b": 12.92, "text": "словами,"}, {"a": 12.94, "b": 15.047, "text": "а название нейросети «Клод» было"}, {"a": 15.047, "b": 15.64, "text": "прописано"}, {"a": 15.66, "b": 18.193, "text": "русскими буквами, иначе синтезатор"}, {"a": 18.193, "b": 18.64, "text": "мог бы"}, {"a": 18.66, "b": 20.368, "text": "прочитать это как-то криво и"}, {"a": 20.368, "b": 21.1, "text": "неправильно."}, {"a": 21.12, "b": 22.756, "text": "Перед генерацией я часть текста"}, {"a": 22.756, "b": 23.02, "text": "также"}, {"a": 23.04, "b": 24.57, "text": "сократила, чтобы уложиться в"}, {"a": 24.57, "b": 25.28, "text": "хронометраж и"}, {"a": 25.3, "b": 26.624, "text": "не растягивать ролик."}, {"a": 26.644, "b": 29.244, "text": "А теперь представьте другое утро."}, {"a": 29.264, "b": 31.658, "text": "Вы просыпаетесь, наливаете себе"}, {"a": 31.658, "b": 32.044, "text": "кофе,"}, {"a": 32.064, "b": 33.433, "text": "открываете почту…"}], "windows": [{"a": 7.5, "b": 8.8, "kind": "stinger"}, {"a": 8.49, "b": 23.97, "kind": "screen"}, {"a": 23.97, "b": 26.534, "kind": "broll"}, {"a": 26.534, "b": 33.267, "kind": "listen"}, {"a": 33.197, "b": 33.433, "kind": "stinger"}]}, {"name": "reel_5_vakansiya", "title": ["Вакансия: человек", "на анимации в Claude"], "duration": 50.533, "parts": [{"src": "long", "a": 429.26666666666665, "b": 479.8, "out": 0.0}], "subs": [{"a": 0.146, "b": 1.768, "text": "А теперь про деньги. Пока я делала"}, {"a": 1.768, "b": 2.293, "text": "этот ролик,"}, {"a": 2.313, "b": 3.656, "text": "мне стало интересно, сколько же"}, {"a": 3.656, "b": 3.873, "text": "можно"}, {"a": 3.893, "b": 5.785, "text": "зарабатывать на создании таких"}, {"a": 5.785, "b": 6.353, "text": "роликов с"}, {"a": 6.373, "b": 8.941, "text": "моушн-анимацией. Я пошла на биржу"}, {"a": 8.941, "b": 9.563, "text": "фриланса"}, {"a": 9.586, "b": 11.498, "text": "и поискала заказы. Вот что я нашла"}, {"a": 11.498, "b": 11.836, "text": "только"}, {"a": 11.856, "b": 13.598, "text": "за последние недели: «Создание"}, {"a": 13.598, "b": 14.353, "text": "анимационного"}, {"a": 14.373, "b": 17.188, "text": "ролика 20–25 секунд для сайта»,"}, {"a": 17.188, "b": 18.55, "text": "«Моушн-дизайнер"}, {"a": 18.57, "b": 20.255, "text": "для рекламных роликов и"}, {"a": 20.255, "b": 21.28, "text": "ИИ-креативов»."}, {"a": 21.3, "b": 23.128, "text": "Заказчик прямо просит написать, с"}, {"a": 23.128, "b": 23.46, "text": "какими"}, {"a": 23.48, "b": 25.15, "text": "нейросетями ты работаешь. И вот"}, {"a": 25.15, "b": 25.796, "text": "мой любимый:"}, {"a": 25.816, "b": 27.865, "text": "«Постоянный человек на анимации в"}, {"a": 27.865, "b": 28.796, "text": "Claude». Ролики"}, {"a": 28.816, "b": 30.647, "text": "до минуты, вся работа в Claude,"}, {"a": 30.647, "b": 30.883, "text": "опыт"}, {"a": 30.903, "b": 32.543, "text": "в анимации не обязателен."}, {"a": 32.783, "b": 34.117, "text": "Ну, классно же! Понимаешь, что"}, {"a": 34.117, "b": 34.606, "text": "происходит?"}, {"a": 34.626, "b": 36.947, "text": "Заказчики уже ищут не конкретно"}, {"a": 36.947, "b": 37.246, "text": "прям"}, {"a": 37.266, "b": 38.917, "text": "моушн-дизайнера с дорогими"}, {"a": 38.917, "b": 39.806, "text": "программами, а"}, {"a": 39.826, "b": 41.832, "text": "человека, который умеет делать"}, {"a": 41.832, "b": 42.3, "text": "видео с"}, {"a": 42.32, "b": 44.253, "text": "помощью нейросети. На биржах"}, {"a": 44.253, "b": 45.22, "text": "фриланса такой"}, {"a": 45.24, "b": 47.446, "text": "ролик стоит от 3 000 ₽ и выше."}, {"a": 47.466, "b": 49.296, "text": "И это ровно то, что я сейчас"}, {"a": 49.316, "b": 50.533, "text": "показала в видео."}], "windows": [{"a": 0.0, "b": 0.816, "kind": "stinger"}, {"a": 7.433, "b": 10.033, "kind": "broll"}, {"a": 10.726, "b": 30.926, "kind": "tier"}, {"a": 49.43, "b": 50.533, "kind": "insert"}]}, {"name": "reel_6_reklama_dorozhaet", "title": ["Реклама дорожает.", "А клиенты нужны каждый месяц"], "duration": 16.9, "parts": [{"src": "rv", "a": 0.0, "b": 16.9, "out": 0.0}], "subs": [{"a": 0.0, "b": 2.284, "text": "Реклама дорожает каждый год, а"}, {"a": 2.284, "b": 4.34, "text": "клиенты нужны каждый месяц."}, {"a": 4.5, "b": 6.174, "text": "За три года привлечь одного"}, {"a": 6.174, "b": 8.282, "text": "клиента через рекламу стало дороже"}, {"a": 8.282, "b": 10.08, "text": "почти в два с половиной раза."}, {"a": 10.38, "b": 12.24, "text": "Крупный бизнес еще может за это"}, {"a": 12.24, "b": 12.72, "text": "платить,"}, {"a": 12.88, "b": 14.933, "text": "а маленьким экспертам остаются"}, {"a": 14.933, "b": 16.78, "text": "контент и сарафанное радио."}], "windows": []}, {"name": "reel_7_drugoe_utro", "title": ["Представьте", "другое утро…"], "duration": 31.85, "parts": [{"src": "rv", "a": 16.85, "b": 37.75, "out": 0.0}, {"src": "rv", "a": 45.9, "b": 56.85, "out": 20.9}], "subs": [{"a": 0.11, "b": 2.45, "text": "А теперь представьте другое утро."}, {"a": 2.73, "b": 4.98, "text": "Вы просыпаетесь, наливаете себе"}, {"a": 4.98, "b": 6.65, "text": "кофе, открываете почту,"}, {"a": 6.79, "b": 9.28, "text": "а там уже лежат 10 готовых писем"}, {"a": 9.28, "b": 11.07, "text": "вашим будущим клиентам."}, {"a": 11.07, "b": 13.93, "text": "Их подготовили ваши ИИ-сотрудники."}, {"a": 14.31, "b": 16.01, "text": "Разведчик находит компании."}, {"a": 16.41, "b": 18.088, "text": "Исследователь смотрит, где им"}, {"a": 18.088, "b": 19.13, "text": "нужна ваша помощь,"}, {"a": 19.21, "b": 20.83, "text": "а менеджер пишет письмо."}, {"a": 20.96, "b": 22.969, "text": "Вам остается только проверить и"}, {"a": 22.969, "b": 24.2, "text": "нажать «Отправить»."}, {"a": 24.2, "b": 26.12, "text": "Меньше минуты на одно письмо."}, {"a": 26.48, "b": 28.083, "text": "Десять минут утром — и вы"}, {"a": 28.083, "b": 28.66, "text": "свободны."}, {"a": 28.8, "b": 31.371, "text": "Письма работают, а вы живете свой"}, {"a": 31.371, "b": 31.76, "text": "день."}, {"a": 31.76, "b": 31.811, "text": "Работаете над проектами, гуляете,"}, {"a": 31.811, "b": 31.85, "text": "проводите время с семьей."}], "windows": []}, {"name": "reel_8_ne_tolko_golova", "title": ["Рилсы не обязаны быть", "говорящей головой"], "duration": 45.6, "parts": [{"src": "long", "a": 383.76666666666665, "b": 429.3666666666667, "out": 0.0}], "subs": [{"a": 0.143, "b": 2.523, "text": "Но реклама – это не единственное,"}, {"a": 2.543, "b": 4.383, "text": "для чего пригодятся такие ролики."}, {"a": 4.463, "b": 6.023, "text": "Ещё одна вещь, которую я поняла,"}, {"a": 6.043, "b": 7.183, "text": "пока создавала это видео,"}, {"a": 7.183, "b": 8.003, "text": "поскольку делается"}, {"a": 8.023, "b": 10.163, "text": "это очень легко, быстро и просто,"}, {"a": 10.223, "b": 12.283, "text": "я подумала о том, что именно такой"}, {"a": 12.303, "b": 13.791, "text": "технологией, как моушн-анимация,"}, {"a": 13.791, "b": 14.023, "text": "можно"}, {"a": 14.043, "b": 15.771, "text": "разбавить видео с говорящей"}, {"a": 15.771, "b": 16.283, "text": "головой."}, {"a": 16.303, "b": 18.052, "text": "Например, если вы делаете много"}, {"a": 18.052, "b": 18.503, "text": "коротких"}, {"a": 18.523, "b": 20.343, "text": "роликов из одного длинного видео,"}, {"a": 20.363, "b": 21.406, "text": "то получается несколько"}, {"a": 21.406, "b": 22.223, "text": "однообразный такой"}, {"a": 22.243, "b": 23.791, "text": "формат, и его очень хорошо"}, {"a": 23.791, "b": 24.743, "text": "разнообразит как"}, {"a": 24.763, "b": 25.743, "text": "раз моушн-анимация."}, {"a": 25.763, "b": 26.993, "text": "Вам ничего не нужно будет"}, {"a": 26.993, "b": 27.583, "text": "переснимать,"}, {"a": 27.603, "b": 29.381, "text": "доснимать. Можно сделать полностью"}, {"a": 29.381, "b": 30.113, "text": "рилс из моушн-"}, {"a": 30.133, "b": 31.779, "text": "анимации, можно вставлять его"}, {"a": 31.779, "b": 32.233, "text": "точечно,"}, {"a": 32.253, "b": 34.473, "text": "но в любом случае формат и подача"}, {"a": 34.493, "b": 36.359, "text": "уже сразу оживет, будет интереснее"}, {"a": 36.359, "b": 36.853, "text": "смотреть."}, {"a": 36.94, "b": 38.66, "text": "И в производстве это очень просто,"}, {"a": 38.68, "b": 40.12, "text": "не нужно ничего переснимать,"}, {"a": 40.12, "b": 40.686, "text": "просто есть"}, {"a": 40.706, "b": 42.985, "text": "замысел, есть закадровый голос,"}, {"a": 42.985, "b": 43.206, "text": "всё"}, {"a": 43.226, "b": 45.6, "text": "остальное делает за вас нейросеть."}], "windows": [{"a": 13.893, "b": 16.493, "kind": "broll"}, {"a": 16.553, "b": 23.053, "kind": "insert"}, {"a": 45.016, "b": 45.6, "kind": "stinger"}]}]